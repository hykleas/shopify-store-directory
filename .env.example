# Postgres (Neon in production, local docker postgres in development)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public site URL (used for canonical links, sitemap, bot user-agent contact page)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identify the crawler honestly. Must contain a contact URL.
BOT_USER_AGENT=StoreDirectoryBot/1.0 (+http://localhost:3000/bot)
