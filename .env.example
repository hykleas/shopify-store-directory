# Postgres — Supabase (uretim) veya lokal docker postgres (gelistirme)
#
# Vercel'de:   Supabase > Connect > "Transaction pooler"  (port 6543)
# Crawler'da:  Supabase > Connect > "Session pooler"      (port 5432)
# Lokalde:     postgresql://sd:sd@localhost:5433/storedir
DATABASE_URL=postgresql://postgres.<proje-ref>:<sifre>@aws-0-<bolge>.pooler.supabase.com:6543/postgres

# Sitenin kanonik adresi (sitemap, metadata, bot iletisim linki)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Crawler kimligi. Icinde /bot sayfasina giden bir URL olmali.
BOT_USER_AGENT=StoreDirectoryBot/1.0 (+http://localhost:3000/bot)
